{
  "name": "statelens-sdk",
  "version": "0.1.0",
  "description": "Drop-in screenshot gateway for UI agents. Filters redundant frames, extracts semantic state changes, and cuts vision-token spend. Ships as an MCP server, an in-process routing library, and a local Anthropic-compatible proxy. Measured 70-82% input-token and 81-90% cost reduction on real Anthropic API calls.",
  "type": "module",
  "bin": {
    "statelens": "./dist/src/index.js"
  },
  "main": "./dist/src/library.js",
  "types": "./dist/src/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/library.d.ts",
      "import": "./dist/src/library.js"
    },
    "./playwright": {
      "types": "./dist/src/adapters/playwright.d.ts",
      "import": "./dist/src/adapters/playwright.js"
    },
    "./adapters": {
      "types": "./dist/src/adapters/routeObservation.d.ts",
      "import": "./dist/src/adapters/routeObservation.js"
    },
    "./pipeline": {
      "types": "./dist/src/pipeline/index.d.ts",
      "import": "./dist/src/pipeline/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "serve": "node dist/src/server.js",
    "proxy": "node dist/src/index.js proxy",
    "run": "node dist/demo/run.js",
    "demo:computer-use": "node dist/demo/agent_loop/playwright_login.js",
    "measure": "node dist/eval/measure_tokens.js",
    "eval:live": "node dist/eval/live_full_test.js",
    "accuracy": "node dist/eval/accuracy_check.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "ui-agent",
    "computer-use",
    "browser-automation",
    "playwright",
    "screenshot",
    "compression",
    "observability",
    "ai-agent"
  ],
  "author": "zhizhongs <zhizhongs@uchicago.edu>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhizhongs/statelens.git"
  },
  "bugs": {
    "url": "https://github.com/zhizhongs/statelens/issues"
  },
  "homepage": "https://github.com/zhizhongs/statelens#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "pixelmatch": "^6.0.0",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pixelmatch": "^5.2.6",
    "playwright": "^1.60.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
