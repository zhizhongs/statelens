{
  "name": "statelens",
  "version": "0.1.0",
  "description": "Open-source MCP server for UI agent observation compression. Filters redundant screenshots, extracts semantic state changes, cuts VLM calls by 85%.",
  "type": "module",
  "bin": {
    "statelens": "./dist/src/index.js"
  },
  "main": "./dist/src/pipeline/index.js",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "serve": "node dist/src/server.js",
    "run": "node dist/demo/run.js",
    "demo:computer-use": "node dist/demo/agent_loop/playwright_login.js",
    "measure": "node dist/eval/measure_tokens.js",
    "eval:live": "node dist/eval/live_full_test.js",
    "accuracy": "node dist/eval/accuracy_check.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ui-agent",
    "computer-use",
    "screenshot",
    "compression",
    "observability"
  ],
  "author": "zhizhongs <zhizhongs@uchicago.edu>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "pixelmatch": "^6.0.0",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pixelmatch": "^5.2.6",
    "playwright": "^1.60.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
